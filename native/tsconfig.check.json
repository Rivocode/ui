{
  // A passagem de tipos sobre a fonte PUBLICADA.
  //
  // Ela NAO entra no `bun run check`, e a razao e onde os tipos moram: react e
  // react-native sao peers, e o unico lugar do repositorio onde estao
  // instalados e `examples/native`, que nao e workspace - `bun install
  // --frozen-lockfile` nunca o instala. No CI e na publicacao o check rodaria
  // sobre um mundo sem react-native e falharia em toda linha, e a tag de
  // release cairia junto. Ela roda no job proprio do CI, que instala o
  // exemplo antes.
  //
  // O nome NAO e `tsconfig.json` de proposito: o bun le o tsconfig.json mais
  // proximo do arquivo para resolver import, e o mapa de `paths` abaixo faria
  // `native/test/` puxar o React do app de exemplo. Duas copias do React no
  // mesmo processo, e os 57 testes daqui morrem em "Invalid hook call". O pacote exporta ./src/index.ts,
  // entao o que sai daqui torto vira erro no tsc de quem consome - e o
  // skipLibCheck deles nao ajuda, porque ele so cobre .d.ts. O tsconfig da raiz
  // nunca olhou para ca: ele inclui src, test, scripts e demo.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    // Ligada porque o app que nos consome compila a NOSSA fonte: projeto novo
    // com strict costuma ligar esta flag, e ai oito indexacoes nossas - o mapa
    // de tom do Badge e do Alert, o token do spinner do Button, o nome do mes
    // do Calendar - derrubavam o tsc de quem so queria usar a peca. Rigidez
    // nossa nao pode virar erro no app dos outros.
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": [],
    // react e react-native sao peers: nao existem no node_modules da raiz, e
    // o unico lugar do repositorio onde estao instalados e o app de exemplo.
    // Apontar para la e o que permite conferir sem duplicar a instalacao.
    "typeRoots": ["../examples/native/node_modules", "../node_modules/@types"],
    "paths": {
      "*": [
        "../examples/native/node_modules/@types/*",
        "../examples/native/node_modules/*",
        "../node_modules/*"
      ]
    }
  },
  "include": ["src", "nativewind-env.d.ts"]
}
