{
  "name": "@rivocode/ui-native",
  "version": "0.2.0",
  "description": "As peças do design system da RivoCode em React Native: o mesmo vocabulário de classes do web, via NativeWind, sobre os mesmos tokens.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rivocode/ui.git",
    "directory": "native"
  },
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./form": "./src/form/index.ts",
    "./chart": "./src/chart/index.ts",
    "./clipboard": "./src/clipboard/index.ts",
    "./file-upload": "./src/file-upload/index.ts",
    "./tokens": "./tokens.ts",
    "./theme.css": "./theme.css"
  },
  "bin": {
    "rivocode-ui-native-css": "scripts/build-css.mjs"
  },
  "files": [
    "src",
    "scripts",
    "tokens.ts",
    "tokens.json",
    "theme.css",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@hookform/resolvers": "^5",
    "expo-clipboard": ">=57",
    "expo-document-picker": ">=57",
    "nativewind": ">=5.0.0-preview.1",
    "react": ">=19",
    "react-hook-form": "^7",
    "react-native": ">=0.76",
    "react-native-svg": ">=15",
    "zod": "^3.25.0 || ^4"
  },
  "peerDependenciesMeta": {
    "@hookform/resolvers": {
      "optional": true
    },
    "expo-clipboard": {
      "optional": true
    },
    "expo-document-picker": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "dependencies": {
    "tailwind-merge": "^3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
