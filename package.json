{
  "name": "@rivocode/ui",
  "version": "0.3.0",
  "workspaces": [
    "apps/*"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rivocode/ui.git"
  },
  "files": [
    "dist",
    "skill",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./preset": "./dist/preset.css",
    "./form": {
      "types": "./dist/form/index.d.ts",
      "default": "./dist/form/index.js"
    },
    "./chart": {
      "types": "./dist/chart/index.d.ts",
      "default": "./dist/chart/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsdown && bun run build:css && bun run build:skill",
    "build:css": "tailwindcss -i src/styles.css -o dist/styles.css && bun run scripts/copy-fonts.ts dist/styles.css && bun run scripts/build-preset.ts",
    "test": "bun test",
    "lint": "oxlint",
    "format": "oxfmt",
    "check": "bun run lint && bun run check:types && bun run check:previews && bun run check:colors && bun run check:contrast && bun run check:temas && bun run check:contrato && bun test",
    "check:colors": "bun run scripts/check-no-literal-colors.ts",
    "check:contrast": "bun run scripts/check-contrast.ts",
    "demo": "bun build demo/demo.tsx demo/dialog.tsx demo/listagem.tsx demo/flutuantes.tsx demo/datas.tsx demo/formulario.tsx demo/navegacao.tsx demo/controles.tsx demo/dados.tsx demo/folhas.tsx demo/consulta.tsx demo/completos.tsx demo/graficos.tsx --root demo --outdir demo/dist && tailwindcss -i demo/demo.css -o demo/dist/demo.css && bun run scripts/copy-fonts.ts demo/dist/demo.css",
    "shot": "bun run demo && bun run scripts/shot.ts",
    "serve": "bun run scripts/serve.ts",
    "check:types": "tsc --noEmit",
    "check:previews": "tsc --noEmit -p .design-sync/tsconfig.json",
    "check:temas": "bun run scripts/check-temas-documentados.ts",
    "prepublishOnly": "bun run check && bun run build",
    "check:contrato": "bun run scripts/check-contrato-documentado.ts",
    "build:skill": "mkdir -p skill && cp .claude/skills/rivocode-ui/SKILL.md skill/SKILL.md"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react-day-picker": "^10.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.11.6",
    "@hookform/resolvers": "^5.9.1",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "react-hook-form": "^7.86.0",
    "recharts": "^3.10.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@hookform/resolvers": "^5",
    "lucide-react": "^1",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7",
    "recharts": "^3",
    "tailwindcss": "^4",
    "zod": "^4"
  },
  "peerDependenciesMeta": {
    "@hookform/resolvers": {
      "optional": true
    },
    "lucide-react": {
      "optional": false
    },
    "react-hook-form": {
      "optional": true
    },
    "recharts": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "homepage": "https://ds.rivocode.com.br",
  "bugs": {
    "url": "https://github.com/Rivocode/ui/issues"
  },
  "description": "Design system da RivoCode: 65 componentes React sobre a Base UI, com tokens em tres camadas, dois temas e duas densidades.",
  "keywords": [
    "design-system",
    "react",
    "base-ui",
    "tailwind",
    "components",
    "ui",
    "rivocode"
  ],
  "bin": {
    "rivocode-ui": "dist/cli.js"
  }
}
