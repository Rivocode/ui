{
  "name": "@rivocode/ui",
  "version": "1.2.0",
  "description": "Design system da RivoCode: 134 componentes React sobre a Base UI, com tokens em tres camadas, dois temas e duas densidades.",
  "keywords": [
    "base-ui",
    "components",
    "design-system",
    "react",
    "rivocode",
    "tailwind",
    "ui"
  ],
  "homepage": "https://ds.rivocode.com.br",
  "bugs": {
    "url": "https://github.com/Rivocode/ui/issues"
  },
  "license": "MIT",
  "author": "RivoCode (https://rivocode.com.br)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rivocode/ui.git"
  },
  "bin": {
    "rivocode-ui": "dist/cli.js"
  },
  "workspaces": [
    "apps/*",
    "mcp"
  ],
  "files": [
    "dist",
    "skill",
    "agent",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./fonts.css": "./dist/fonts.css",
    "./preset": "./dist/preset.css",
    "./tokens/*": "./dist/tokens/*",
    "./form": {
      "types": "./dist/form/index.d.ts",
      "default": "./dist/form/index.js"
    },
    "./chart": {
      "types": "./dist/chart/index.d.ts",
      "default": "./dist/chart/index.js"
    },
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "default": "./dist/ai/index.js"
    },
    "./dnd": {
      "types": "./dist/dnd/index.d.ts",
      "default": "./dist/dnd/index.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "default": "./dist/editor/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsdown && bun run build:css && bun run build:tokens && bun run build:skill && bun run build:mcp",
    "build:mcp": "bun run --cwd mcp build",
    "smoke:mcp": "bun run scripts/mcp-smoke.ts",
    "build:tokens": "bun dist/cli.js tokens --out dist/tokens",
    "build:css": "tailwindcss -i src/styles.css -o dist/styles.css && bun run scripts/compact-css.ts dist/styles.css && bun run build:fonts && bun run scripts/build-preset.ts",
    "build:fonts": "tailwindcss -i src/tokens/themes/rivocode-fonts.css -o dist/fonts.css && bun run scripts/copy-fonts.ts dist/fonts.css",
    "test": "bun test",
    "lint": "oxlint",
    "format": "oxfmt",
    "check": "bun run check:install && bun run lint && bun run check:types && bun run check:previews && bun run check:props && bun run check:names && bun run check:comments && bun run check:colors && bun run check:opacity && bun run check:contrast && bun run check:contrast:native-map && bun run check:native:contrast && bun run check:themes && bun run check:contract && bun run check:doc && bun run check:examples && bun run check:readme && bun run check:classes && bun run check:groups && bun run check:chart && bun run check:cli && bun run check:size && bun run check:skill && bun run check:skill-list && bun run check:native && bun run check:theme:native && bun run check:shared && bun run check:parity && bun run check:signature && bun run check:pieces && bun run check:demo && bun run check:portraits && bun run check:recipe && bun run check:scripts && bun run check:floor && bun run check:tests && bun run check:mcp && bun test",
    "check:colors": "bun run scripts/check-no-literal-colors.ts",
    "check:opacity": "bun run scripts/check-opacity.ts",
    "check:contrast": "bun run scripts/check-contrast.ts",
    "check:contrast:native-map": "bun run scripts/check-contrast-native.ts",
    "gen:native:contrast": "bun run scripts/gen-native-contrast.ts",
    "check:native:contrast": "bun run scripts/gen-native-contrast.ts --check",
    "check:cli": "bun run scripts/check-cli-boundary.ts",
    "check:size": "bun run scripts/check-package-size.ts",
    "demo": "bun build demo/demo.tsx demo/dialog.tsx demo/listagem.tsx demo/flutuantes.tsx demo/datas.tsx demo/formulario.tsx demo/navegacao.tsx demo/controles.tsx demo/dados.tsx demo/folhas.tsx demo/consulta.tsx demo/completos.tsx demo/graficos.tsx demo/novas.tsx demo/painel.tsx demo/paleta.tsx demo/ia.tsx demo/arrastar.tsx demo/editor.tsx demo/tour.tsx demo/cronograma.tsx --root demo --outdir demo/dist && tailwindcss -i demo/demo.css -o demo/dist/demo.css && bun run scripts/copy-fonts.ts demo/dist/demo.css",
    "visual": "bun run scripts/visual-regression.ts",
    "a11y": "bun run demo && bun run scripts/accessibility.ts",
    "shot": "bun run demo && bun run scripts/shot.ts",
    "serve": "bun run scripts/serve.ts",
    "check:types": "tsc --noEmit",
    "gen:props": "bun run scripts/catalog-props.ts",
    "check:props": "bun run scripts/catalog-props.ts --check",
    "gen:props:native": "bun run scripts/native-catalog-props.ts",
    "check:props:native": "bun run scripts/native-catalog-props.ts --check",
    "check:names": "bun run scripts/check-names-in-english.ts",
    "check:comments": "bun run scripts/check-comments-in-english.ts",
    "gen:native": "bun run scripts/gen-native-tokens.ts",
    "check:parity": "bun run scripts/native-parity.ts --check",
    "gen:signature": "bun run scripts/native-signature.ts",
    "check:signature": "bun run scripts/native-signature.ts --check",
    "check:native": "bun run scripts/gen-native-tokens.ts --check",
    "check:theme:native": "bun run scripts/check-theme-generator.ts",
    "gen:shared": "bun run scripts/shared-code.ts",
    "check:shared": "bun run scripts/shared-code.ts --check",
    "check:native:types": "tsc --noEmit -p native/tsconfig.check.json",
    "check:previews": "tsc --noEmit -p .design-sync/tsconfig.json",
    "check:themes": "bun run scripts/check-documented-themes.ts",
    "gen:themes": "bun run scripts/check-documented-themes.ts --write",
    "prepublishOnly": "bun run check && bun run build",
    "check:classes": "bun run scripts/check-class-without-rule.ts",
    "check:groups": "bun run scripts/check-class-groups.ts",
    "check:doc": "bun run scripts/check-doc-has-code.ts",
    "check:examples": "bun run scripts/check-doc-examples.ts",
    "check:readme": "bun run scripts/check-readme-coverage.ts",
    "check:contract": "bun run scripts/check-documented-contract.ts",
    "check:chart": "bun run scripts/check-chart-boundary.ts",
    "check:skill": "bun run scripts/check-skill-props.ts",
    "check:skill-list": "bun run scripts/check-skill-list.ts",
    "build:skill": "rm -rf skill agent && mkdir -p skill agent && cp -R .claude/skills/rivocode-ui/. skill/ && cp .claude/agents/rivocode-ui.md agent/rivocode-ui.md",
    "check:install": "bun run scripts/check-single-install.ts",
    "check:pieces": "bun run scripts/check-piece-count.ts",
    "check:recipe": "bun run scripts/check-install-recipe.ts",
    "check:scripts": "bun run scripts/check-scripts-outside-gate.ts",
    "check:floor": "bun run scripts/check-scan-floor.ts",
    "check:tests": "bun run scripts/check-test-count.ts",
    "check:mcp": "bun run scripts/check-mcp-up-to-date.ts",
    "check:demo": "bun run scripts/check-demo.ts",
    "check:portraits": "bun run scripts/check-portraits.ts",
    "retrato": "bun run demo && bun run scripts/shot.ts --secao"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react-day-picker": "^10.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@happy-dom/global-registrator": "^20.14.5",
    "@hookform/resolvers": "^5.9.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extensions": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "axe-core": "^4.13.0",
    "jsqr": "^1.4.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "react-hook-form": "^7.88.0",
    "react-test-renderer": "^19",
    "recharts": "^3.10.1",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@dnd-kit/core": "^6.3.0",
    "@dnd-kit/sortable": "^10",
    "@hookform/resolvers": "^5",
    "@tiptap/core": "^3",
    "@tiptap/extensions": "^3",
    "@tiptap/pm": "^3",
    "@tiptap/react": "^3",
    "@tiptap/starter-kit": "^3",
    "lucide-react": "^1",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7",
    "recharts": "^3",
    "tailwindcss": "^4",
    "zod": "^3.25.0 || ^4"
  },
  "peerDependenciesMeta": {
    "@dnd-kit/core": {
      "optional": true
    },
    "@dnd-kit/sortable": {
      "optional": true
    },
    "@hookform/resolvers": {
      "optional": true
    },
    "@tiptap/core": {
      "optional": true
    },
    "@tiptap/extensions": {
      "optional": true
    },
    "@tiptap/pm": {
      "optional": true
    },
    "@tiptap/react": {
      "optional": true
    },
    "@tiptap/starter-kit": {
      "optional": true
    },
    "lucide-react": {
      "optional": false
    },
    "react-hook-form": {
      "optional": true
    },
    "recharts": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
