{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["vite/client"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "@rivocode/ui": ["../../src/index.ts"],
      "@rivocode/ui/form": ["../../src/form/index.ts"],
      "@rivocode/ui/chart": ["../../src/chart/index.ts"],
      "@rivocode/ui/ai": ["../../src/ai/index.ts"],
      "@rivocode/ui/dnd": ["../../src/dnd/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts", "prerender.ts"]
}
