{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // Os previews importam pelo nome publico do pacote, como o projeto
    // consumidor faz. O apontamento manda para o fonte, entao a checagem vale
    // sem depender de build nem de `bun link`.
    "paths": {
      "@rivocode/ui": ["../src/index.ts"],
      "@rivocode/ui/form": ["../src/form/index.ts"]
    }
  },
  "include": ["previews"]
}
