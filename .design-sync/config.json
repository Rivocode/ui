    "FieldLabel": ".design-sync/docs/FieldLabel.md",
    "Input": ".design-sync/docs/Input.md",
    "Menu": ".design-sync/docs/Menu.md",
    "MenuContent": ".design-sync/docs/MenuContent.md",
    "MenuGroup": ".design-sync/docs/MenuGroup.md",
    "MenuItem": ".design-sync/docs/MenuItem.md",
