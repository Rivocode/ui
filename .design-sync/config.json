    "TableCell": ".design-sync/docs/TableCell.md",
    "TableHead": ".design-sync/docs/TableHead.md",
    "TableHeader": ".design-sync/docs/TableHeader.md",
    "TableRow": ".design-sync/docs/TableRow.md",
