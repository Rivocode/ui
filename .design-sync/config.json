  "provider": {
    "component": "RivoProvider",
    "props": {
      "theme": "rivocode-dark",
      "scope": "local",
      "className": "min-h-full p-6"
    }
  },
  "overrides": {
    "Checkbox": {
      "cardMode": "column"
    },
    "Dialog": {
      "cardMode": "single",
      "primaryStory": "Confirmacao"
    },
    "Menu": {
      "cardMode": "single",
      "primaryStory": "AcoesDaLinha"
    },
    "Select": {
      "cardMode": "single",
      "primaryStory": "Aberto"
    },
    "Tooltip": {
      "cardMode": "single",
      "primaryStory": "EmBotaoDeIcone"
    },
    "ToastViewport": {
      "cardMode": "single",
      "primaryStory": "AvisoDeSucesso"
    }
  }
